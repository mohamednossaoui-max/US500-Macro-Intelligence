name: Collect Economic Intelligence Phase 1A.1

on:
  workflow_dispatch:
  push:
    paths:
      - "economic_release_collector_v1.py"
      - "economic_data_v1.py"
      - "requirements.txt"
      - ".github/workflows/collect_economic_data_v1.yml"

jobs:
  collect-economic-data:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Verify scripts
        run: |
          test -f "./economic_release_collector_v1.py"
          test -f "./economic_data_v1.py"
          python -m py_compile "./economic_release_collector_v1.py"
          python -m py_compile "./economic_data_v1.py"
          echo "Economic scripts syntax OK."

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install pandas requests beautifulsoup4 pypdf openpyxl

      - name: Run official release collector
        run: |
          python "./economic_release_collector_v1.py"

      - name: Verify collected input
        run: |
          test -f "./economic_release_records_input_v1.csv"
          python - <<'PY'
          import pandas as pd
          df = pd.read_csv("economic_release_records_input_v1.csv")
          print("Collected rows:", len(df))
          print(df.groupby("indicator").size())
          assert len(df) > 0
          assert df["source"].notna().all()
          assert df["source_url"].notna().all()
          assert df["actual"].notna().all()
          PY

      - name: Run Phase 1A quality gate
        run: |
          python "./economic_data_v1.py"

      - name: Verify Phase 1A outputs
        run: |
          test -f "./economic_events_v1.csv"
          test -f "./economic_data_quality_v1.csv"
          echo "Phase 1A outputs exist."

      - name: Display results
        run: |
          echo "=============================="
          echo "ECONOMIC DATA QUALITY"
          echo "=============================="
          cat "./economic_data_quality_v1.csv"
          echo ""
          echo "=============================="
          echo "ECONOMIC EVENTS"
          echo "=============================="
          head -n 40 "./economic_events_v1.csv"

      - name: Upload Phase 1A results
        uses: actions/upload-artifact@v4
        with:
          name: economic-intelligence-phase-1a-1
          path: |
            economic_release_records_input_v1.csv
            economic_events_v1.csv
            economic_data_quality_v1.csv
